# Copy this file to ".env" and fill in at least one key. Never commit .env.
# Both are free and need no card.

# Groq: https://console.groq.com/keys   (used first: highest free limits)
GROQ_API_KEY=

# Gemini: https://aistudio.google.com/apikey   (used when Groq's limit is reached)
GEMINI_API_KEY=

# No key at all also works: install Ollama (https://ollama.com), run "ollama pull llama3.1",
# and the crawler will use the local model. With nothing available it falls back to pattern matching.
